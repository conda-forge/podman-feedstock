From a7185fef8a4a6bd7526b75292ef1aec5c4751b31 Mon Sep 17 00:00:00 2001
From: Uwe Korn <uwelk@xhochy.com>
Date: Thu, 12 Nov 2026 10:55:37 +0000
Subject: [PATCH] relative paths for system config and binaries

Conda environments are self-contained: the containers config files and the
helper binaries are installed into the environment prefix, not into /etc,
/usr/libexec or /usr/lib.  Derive those default paths from the location of
the running executable (PREFIX/bin/podman) instead of hard-coding the
system-wide locations.  The helper binary directories can use the existing
$BINDIR mechanism.
---
 .../common/pkg/config/config_darwin.go        |  3 ++
 .../common/pkg/config/config_linux.go         |  6 ++++
 .../storage/pkg/configfile/parse.go           | 30 ++++++++++++++++++-
 .../storage/pkg/configfile/path.go            |  2 +-
 4 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_darwin.go b/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_darwin.go
index a544f5f..15f3707 100644
--- a/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_darwin.go
+++ b/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_darwin.go
@@ -3,6 +3,9 @@ package config
 var defaultHelperBinariesDir = []string{
 	// Relative to the binary directory
 	"$BINDIR/../libexec/podman",
+	// Conda installs the helper binaries into the environment prefix.
+	"$BINDIR/../lib/podman",
+	"$BINDIR",
 	// Homebrew install paths
 	"/usr/local/opt/podman/libexec/podman",
 	"/opt/homebrew/opt/podman/libexec/podman",
diff --git a/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_linux.go b/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_linux.go
index e0b4672..f6912df 100644
--- a/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_linux.go
+++ b/src/github.com/containers/podman/vendor/go.podman.io/common/pkg/config/config_linux.go
@@ -5,6 +5,12 @@ import (
 )
 
 var defaultHelperBinariesDir = []string{
+	// Relative to the binary directory. Conda installs the helper binaries
+	// into PREFIX/libexec/podman (rootlessport, quadlet), PREFIX/lib/podman
+	// (netavark) and PREFIX/bin (aardvark-dns).
+	"$BINDIR/../libexec/podman",
+	"$BINDIR/../lib/podman",
+	"$BINDIR",
 	"/usr/local/libexec/podman",
 	"/usr/local/lib/podman",
 	"/usr/libexec/podman",
diff --git a/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/parse.go b/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/parse.go
index 9a9ea71..e26f269 100644
--- a/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/parse.go
+++ b/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/parse.go
@@ -19,12 +19,40 @@ import (
 
 const _configPathName = "containers"
 
+// GetExePath returns the path to the running executable.
+func GetExePath() string {
+	exePath, err := os.Executable()
+	if err == nil {
+		return exePath
+	}
+	exeRealPath, err := filepath.EvalSymlinks(exePath)
+	if err == nil {
+		return exeRealPath
+	}
+	panic(err)
+}
+
+// PathRelativeToExe turns an absolute default configuration path into a path
+// relative to the Conda environment prefix, which is inferred from the location
+// of the running executable. This assumes the executable resides at
+// PREFIX/bin/executable:
+//
+//	/etc/path       -> PREFIX/bin/../etc/path   -> PREFIX/etc/path
+//	/usr/share/path -> PREFIX/bin/../share/path -> PREFIX/share/path
+func PathRelativeToExe(path string) string {
+	if path == "" {
+		return path
+	}
+	relativePath := strings.TrimPrefix(path, "/usr")
+	return filepath.Join(filepath.Dir(filepath.Dir(GetExePath())), relativePath)
+}
+
 var (
 	// systemConfigPath is the location for the default config files shipped by the distro/vendor.
 	//
 	// This can be overridden at build time with the following go linker flag:
 	// -ldflags '-X go.podman.io/storage/pkg/configfile.systemConfigPath=$your_path'
-	systemConfigPath = builtinSystemConfigPath
+	systemConfigPath = PathRelativeToExe(builtinSystemConfigPath)
 
 	// adminOverrideConfigPath is the location for admin local override config files.
 	//
diff --git a/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/path.go b/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/path.go
index d9443dd..e33b53b 100644
--- a/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/path.go
+++ b/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/path.go
@@ -11,5 +11,5 @@ const (
 )
 
 func getAdminOverrideConfigPath() string {
-	return builtinAdminOverrideConfigPath
+	return PathRelativeToExe(builtinAdminOverrideConfigPath)
 }
