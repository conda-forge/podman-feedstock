+++ b/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/conda_test.go
@@ -0,0 +1,61 @@
+package configfile
+
+import (
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"testing"
+)
+
+func TestCondaSearchPaths(t *testing.T) {
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	prefix := filepath.Dir(filepath.Dir(exe))
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	originalSystem, originalAdmin := systemConfigPath, adminOverrideConfigPath
+	t.Cleanup(func() { systemConfigPath, adminOverrideConfigPath = originalSystem, originalAdmin })
+	systemConfigPath = filepath.Join(t.TempDir(), "share", "containers")
+	adminOverrideConfigPath = t.TempDir()
+
+	for _, name := range []string{"containers", "policy", "registries"} {
+		t.Run(name, func(t *testing.T) {
+			conf := &File{Name: name, Extension: "conf", EnvironmentName: "CONDA_TEST_CONFIG"}
+			hostPath := filepath.Join(adminOverrideConfigPath, name+".conf")
+			prefixPath := filepath.Join(prefix, strings.TrimPrefix(hostPath, "/usr"))
+			paths, err := GetSearchPaths(conf)
+			if err != nil || !slices.Contains(paths.MainFiles, prefixPath) {
+				t.Fatalf("missing prefix fallback: %+v, %v", paths, err)
+			}
+			if err := os.WriteFile(hostPath, []byte(""), 0600); err != nil {
+				t.Fatal(err)
+			}
+			want := hostPath
+			if name == "containers" {
+				want = prefixPath
+			}
+			paths, err = GetSearchPaths(conf)
+			if err != nil || !slices.Contains(paths.MainFiles, want) {
+				t.Fatalf("wrong host config precedence: %+v, %v", paths, err)
+			}
+			conf.RootForImplicitAbsolutePaths = "/alternate-root"
+			paths, err = GetSearchPaths(conf)
+			if err != nil || !slices.Contains(paths.MainFiles, filepath.Join("/alternate-root", hostPath)) {
+				t.Fatalf("alternate root not preserved: %+v, %v", paths, err)
+			}
+			conf.RootForImplicitAbsolutePaths = ""
+			t.Setenv("CONDA_TEST_CONFIG", "/explicit/environment.conf")
+			paths, err = GetSearchPaths(conf)
+			if err != nil || !slices.Equal(paths.MainFiles, []string{"/explicit/environment.conf"}) {
+				t.Fatalf("environment override not preserved: %+v, %v", paths, err)
+			}
+			conf.CustomConfigFilePath = "/explicit/custom.conf"
+			paths, err = GetSearchPaths(conf)
+			if err != nil || !slices.Equal(paths.MainFiles, []string{conf.CustomConfigFilePath}) {
+				t.Fatalf("explicit override not preserved: %+v, %v", paths, err)
+			}
+		})
+	}
+}
