index 0000000000..d7adbecdb3
--- /dev/null
+++ b/src/github.com/containers/podman/vendor/go.podman.io/storage/pkg/configfile/path_relative_to_exe.go
@@ -0,0 +1,53 @@
+package configfile
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// conda is true when this build is meant to be relocated into a conda
+// environment prefix instead of being installed into the system prefix.
+const conda = true
+
+// GetExePath returns the path to the running executable.
+func GetExePath() string {
+	exePath, err := os.Executable()
+	if err == nil {
+		return exePath
+	}
+	exeRealPath, err := filepath.EvalSymlinks(exePath)
+	if err == nil {
+		return exeRealPath
+	}
+	panic(err)
+}
+
+// PathRelativeToExe rewrites default configuration paths so that they are
+// resolved relative to the running executable. This assumes the executable
+// always resides at PREFIX/bin/executable:
+//
+//	/etc/path       -> PREFIX/bin/../etc/path   -> PREFIX/etc/path
+//	/usr/share/path -> PREFIX/bin/../share/path -> PREFIX/share/path
+//
+// An empty path is returned unchanged, as the callers use "" to mean "this
+// location does not apply on this platform".
+func PathRelativeToExe(path string) string {
+	if !conda || path == "" {
+		return path
+	}
+	relativePath := strings.TrimPrefix(path, "/usr")
+	return filepath.Join(filepath.Dir(filepath.Dir(GetExePath())), relativePath)
+}
+
+// FallbackToPathRelativeToExe returns path unchanged when it exists on the
+// system and otherwise falls back to [PathRelativeToExe].
+func FallbackToPathRelativeToExe(path string) string {
+	if !conda || path == "" {
+		return path
+	}
+	if _, err := os.Stat(path); err == nil {
+		return path
+	}
+	return PathRelativeToExe(path)
+}
